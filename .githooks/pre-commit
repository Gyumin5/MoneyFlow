#!/usr/bin/env bash
# 공개 저장소에 들어가면 안 되는 것을 커밋 단계에서 막는다 (2026-11-04).
#
# 이 저장소(github.com/Gyumin5/MoneyFlow)는 공개다. 2026-11-04 에 과거 이력을 다시 써서
# 계좌 금액과 서버 주소를 지웠다. 같은 것이 다시 올라가면 그 작업이 무의미해지므로
# 커밋 단계에서 막는다 — 푸시 단계가 아니라 커밋 단계인 이유는, 푸시에서 막으면
# 이미 로컬 이력에 들어간 뒤라 또 이력을 다시 써야 하기 때문이다.
#
# 막혔을 때 할 일은 패턴을 피해 쓰는 것이 아니라, 그 파일이 공개 저장소에 들어갈
# 것인지부터 보는 것이다. 보고서·로그·업무 산출물이면 reports/ 나 state/ 로 옮긴다
# (둘 다 추적하지 않는다). 운영 코드인데 주소가 필요하면 git 미추적 설정으로 뺀다.
#
# 끄는 법은 없다. --no-verify 로 넘기지 않는다.

set -u

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

note() { printf '%s\n' "$*" >&2; }

# 1) 추적하면 안 되는 경로
for f in $staged; do
  case "$f" in
    reports/*|state/*|logs/*)
      note "막힘: $f — 보고서·세션 산출물·로그는 추적하지 않는다."
      fail=1
      ;;
  esac
done

# 2) 계좌 금액 — 백만 이상 콤마 숫자, 달러 콤마 금액
#    백테스트 수치에도 쓰일 수 있지만, 공개 저장소에서 그 구분을 자동으로 할 수 없다.
#    문서에 큰 수를 적어야 하면 콤마 없이 적거나 단위로 적는다(예: 4억원, 30만달러).
for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qE '\b[0-9]{1,3}(,[0-9]{3}){2,}\b'; then
    note "막힘: $f — 백만 이상 콤마 숫자가 있다(계좌 금액일 수 있다)."
    fail=1
  fi
  if git show ":$f" 2>/dev/null | grep -qE '\$[0-9]{1,3}(,[0-9]{3})+'; then
    note "막힘: $f — 달러 콤마 금액이 있다(계좌 평가액일 수 있다)."
    fail=1
  fi
done

# 3) 서버 주소
for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qE '([0-9]{1,3}\.){3}[0-9]{1,3}' \
     | grep -qvE '(127\.0\.0\.1|0\.0\.0\.0|255\.|192\.168\.|10\.0\.)'; then
    :
  fi
  if git show ":$f" 2>/dev/null | grep -qE '\b152\.69\.[0-9]{1,3}\.[0-9]{1,3}\b'; then
    note "막힘: $f — 운영 서버 주소가 있다. git 미추적 설정으로 뺀다."
    fail=1
  fi
done

# 4) 자격증명 모양
for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qE '(BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|[0-9]{8,10}:AA[0-9A-Za-z_-]{30,})'; then
    note "막힘: $f — 개인키·클라우드 열쇠·봇 토큰 모양이 있다."
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  note ""
  note "커밋을 멈췄다. 이 저장소는 공개다 — 올라간 것은 되돌려도 남는다."
  exit 1
fi

exit 0
